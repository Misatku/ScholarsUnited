extends layout
block content
  section.main-content
    .section-box
      h1 Profile: #{user.fullName}

      p Email: #{user.email}
      p Interests: #{user.interests || 'Not specified'}
      p Year: #{user.year || 'N/A'}

      h2 Events You've Joined
      if userEvents && userEvents.length
        ul
          each event in userEvents
            li
              a(href=`/events/${event.EventID}`) #{event.Title}
      else
        p You haven't joined any events yet.
