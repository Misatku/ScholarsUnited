extends layout
block content
  section.main-content
    .section-box
      if event
        h1= event.Title
        p.event-date #{event.Date} at #{event.Time}
        p.event-location Location: #{event.Location || 'Not specified'}
        p= event.Description

        if !joined
          form(action=`/events/join/${event.EventID}`, method="POST")
            button.btn.btn-primary Join This Event
        else
          p You have already joined this event.
      else
        p Event not found or does not exist.
