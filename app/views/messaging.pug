extends layout
block content
  section.main-content
    .section-box
      h1 Messaging

      form(action="/messages/send", method="POST")
        .form-group
          label(for="recipient") Send to:
          select(name="recipient", required)
            each user in users
              option(value=user._id)= user.fullName

        .form-group
          label(for="message") Message
          textarea(name="message", rows="4", placeholder="Say hello, plan a study session..." required)

        button.btn.btn-primary(type="submit") Send Message

    if messages && messages.length
      .section-box
        h2 Inbox
        each msg in messages
          .message-card
            h4 From: #{msg.senderName}
            p= msg.body
            span.timestamp= new Date(msg.timestamp).toLocaleString()
    else
      p No messages yet.
