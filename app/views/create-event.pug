extends layout
block content
  section.main-content
    .section-box
      h1 Create a New Study Event

      form(action="/events/create", method="POST")
        .form-group
          label(for="title") Event Title
          input(type="text", name="title", required, placeholder="Group Study: Calculus II")

        .form-group
          label(for="date") Date
          input(type="date", name="date", required)

        .form-group
          label(for="time") Time
          input(type="time", name="time", required)

        .form-group
          label(for="location") Location
          input(type="text", name="location", placeholder="Library Room A or Online")

        .form-group
          label(for="description") Description
          textarea(name="description", rows="4", placeholder="Topics, required material, goals...")

        button.btn.btn-primary(type="submit") Create Event
