extends layout
block content
  section.main-content
    .section-box
      h1 Search Study Buddies

      form(action="/search", method="GET")
        .form-group
          input(type="text", name="query", placeholder="Search by name, course, interest")

        button.btn.btn-primary(type="submit") Search

    if results && results.length
      h2 Results
      .card-container
        each user in results
          .profile-card
            h3= user.fullName
            p= user.interests || 'No interests listed'
            a(href=`/users/${user._id}` class="btn btn-secondary") View Profile
    else if results
      p No matching users found.
